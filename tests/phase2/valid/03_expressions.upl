begin
  print(1 + 2 * 3 + 4);
  print((1 + 2) * 3);
  print(2147483647);
  print(128);
  print(32768);
  print(32768 >= 32768);
  print(2 > 3);
  print((1 > 0) == true);
  print(true == false);
  print(2 == 2);
  if (false) then { print(999); }
  for (int i = 0; false; i = i + 1) { print(999); }
  do { print(7); } while (false);
end
